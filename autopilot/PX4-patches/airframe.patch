+param set-default UXRCE_DDS_SYNCT 0
+param set-default UXRCE_DDS_SYNCC 1
+
+param set-default COM_OBL_RC_ACT 3
+
+# >>>>> Failsafe configurations modified for swarmbox.
+# NOTE: these parameter modifications are done for huge scale testings. You may want to change them for your preferred failsafe behaviors.
