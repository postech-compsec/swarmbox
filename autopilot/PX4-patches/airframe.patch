+param set-default COM_ARM_WO_GPS 1 # arm without GNSS config, without warning
+param set-default COM_ARM_BAT_MIN 0 # disable battery low warning
+
+param set-default COM_DISARM_PRFLT -1  # disable disarm preflight checks
+# param set-default COM_POS_FS_DELAY 1
+# param set-default COM_POS_FS_EPH   -1
+
+param set-default NAV_DLL_ACT 0 # disable data link (ground control) loss failsafe
